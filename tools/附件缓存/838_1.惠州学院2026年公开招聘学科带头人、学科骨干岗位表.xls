   <Row ss:AutoFitHeight="0" ss:Height="51" ss:StyleID="s63">
   </Row>

   <Row ss:AutoFitHeight="0" ss:Height="100.05000000000001" ss:StyleID="s63">
    <Cell ss:StyleID="s76"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">2026050221</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">各二级学院</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">学科带头人</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">从事学科带头人工作。</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">专业技术岗位四级以上</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">1</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">不限</Data></Cell>
     <Cell ss:StyleID="s76"><Data ss:Type="String">研究生</Data></Cell>
     <Cell ss:StyleID="s76"><Data ss:Type="String">博士</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">不限</Data></Cell>
     <Cell ss:StyleID="s76"><Data ss:Type="String">正高</Data></Cell>
     <Cell ss:StyleID="s76"><Data ss:Type="String">高等学校教师</Data></Cell>
     <Cell ss:StyleID="s76"><Data ss:Type="String">50周岁以下</Data></Cell>
     <Cell ss:StyleID="s76"><Data ss:Type="String"> 业绩具体要求：1、近五年有以下成果之一：主持过国家自然科学基金、国家社会科学基金项目、国家重大科技项目（含课题）；或以第一作者或通讯作者发表高水平论文4篇以上；或以第一发明人获授权发明专利3项以上；或获得省（部）级及以上科学科研成果奖；或获得国家级优秀教学成果奖 、省（部）级优秀教学成果奖等</Data></Cell>
    <Cell ss:StyleID="s76"><Data ss:Type="String">直接业务考核</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="100.05000000000001" ss:StyleID="s63">
