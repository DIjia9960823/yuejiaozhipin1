    <Cell ss:MergeAcross="15" ss:StyleID="s98"><Data ss:Type="String">惠州学院2026年公开招聘学科带头人、学科骨干岗位表</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="51" ss:StyleID="s63">
    <Cell ss:MergeDown="1" ss:StyleID="m1568727683660"><Data ss:Type="String">序号</Data></Cell>
    <Cell ss:MergeDown="1" ss:StyleID="m1568727683680"><Data ss:Type="String">岗位代码</Data><NamedCell ss:Name="_FilterDatabase"/></Cell>
